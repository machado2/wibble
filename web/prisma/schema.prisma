generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model content {
  id                     String                           @id @db.Char(36)
  slug                   String                           @unique @db.VarChar(500)
  content                String?                          @db.Text
  created_at             DateTime                         @default(now()) @db.Timestamp(0)
  generating             Boolean                          @default(true)
  generation_started_at  DateTime?                        @db.Timestamp(0)
  generation_finished_at DateTime?                        @db.Timestamp(0)
  flagged                Boolean
  model                  String                           @db.VarChar(100)
  prompt_version         Int                              @default(1)
  fail_count             Int                              @default(0)
  description            String                           @db.Text
  image_id               String?                          @db.VarChar(100)
  title                  String                           @db.VarChar(500)
  user_input             String                           @db.Text
  view_count             Int                              @default(0) @map("longview_count")
  image_prompt           String?                          @db.VarChar(1000)
  user_email             String?                          @db.VarChar(350)
  votes                  Int                              @default(0)
  hot_score              Float                            @default(100)
  generation_time_ms     Int?
  published              Boolean                          @default(false)
  generation_status      String                           @default("pending") @db.VarChar(20)
  next_generation_at     DateTime                         @default(now()) @db.Timestamp(3)
  last_generation_error  String?                          @db.VarChar(500)
  votesRelation          content_vote[]
  translations           content_translation[]
  translationAttempts    translation_generation_attempt[]
  translationJobs        translation_job[]

  @@index([votes, view_count], map: "idx_content_votes_view_count")
  @@index([created_at, generating], map: "idx_content_created_at_generating")
  @@index([generation_status, next_generation_at], map: "idx_content_generation_queue")
  @@index([view_count], map: "idx_content_view_count")
  @@index([hot_score], map: "idx_content_hot_score")
}

model content_translation {
  id            String   @id @db.Char(36)
  content_id    String   @db.Char(36)
  language_code String   @db.VarChar(35)
  title         String   @db.VarChar(500)
  description   String   @db.Text
  content       String   @db.Text
  model         String   @db.VarChar(100)
  created_at    DateTime @default(now()) @db.Timestamp(0)
  source        content  @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@unique([content_id, language_code])
  @@index([content_id])
}

model translation_generation_attempt {
  id            String   @id @db.Char(36)
  user_email    String   @db.VarChar(350)
  content_id    String   @db.Char(36)
  language_code String   @db.VarChar(35)
  created_at    DateTime @default(now()) @db.Timestamp(3)
  source        content  @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@index([user_email, created_at])
  @@index([content_id, language_code])
}

model translation_job {
  id              String    @id @db.Char(36)
  content_id      String    @db.Char(36)
  language_code   String    @db.VarChar(35)
  requested_by    String    @db.VarChar(350)
  status          String    @default("pending") @db.VarChar(20)
  attempts        Int       @default(0)
  created_at      DateTime  @default(now()) @db.Timestamp(0)
  updated_at      DateTime  @default(now()) @db.Timestamp(0)
  next_attempt_at DateTime  @default(now()) @db.Timestamp(0)
  started_at      DateTime? @db.Timestamp(0)
  completed_at    DateTime? @db.Timestamp(0)
  last_error      String?   @db.VarChar(500)
  lease_id        String?   @db.Char(36)
  source          content   @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@unique([content_id, language_code])
  @@index([status, next_attempt_at, created_at])
  @@index([language_code, status])
}

model translation_worker_request {
  nonce      String   @id @db.Char(36)
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@index([created_at])
}

model translation_runtime_setting {
  id              String    @id @db.VarChar(40)
  hourly_limit    Int       @default(10)
  budget_reset_at DateTime? @db.Timestamp(3)
  updated_at      DateTime  @default(now()) @db.Timestamp(3)
}

model translation_admin_event {
  id            String   @id @db.Char(36)
  action        String   @db.VarChar(50)
  job_id        String?  @db.Char(36)
  numeric_value Int?
  created_at    DateTime @default(now()) @db.Timestamp(3)

  @@index([created_at])
}

model content_vote {
  content_id String   @db.VarChar(36)
  created_at DateTime @default(now()) @db.Timestamp(0)
  user_email String   @db.VarChar(350)
  downvote   Boolean  @default(false)
  content    content  @relation(fields: [content_id], references: [id], onDelete: NoAction)

  @@id([content_id, user_email])
}

model image_cache {
  id                     String    @id @db.VarChar(100)
  content_id             String?   @db.VarChar(36)
  prompt_hash            String?   @db.VarChar(100)
  prompt                 String    @db.Text
  alt_text               String    @db.VarChar(1000)
  created_at             DateTime  @db.Timestamp(0)
  flagged                Boolean   @default(false)
  regenerate             Boolean   @default(false)
  fail_count             Int       @default(0)
  generator              String?   @db.VarChar(100)
  model                  String?   @db.VarChar(100)
  seed                   String?   @db.VarChar(100)
  parameters             String?   @db.Text
  view_count             Int       @default(0)
  status                 String    @db.VarChar(100)
  last_error             String?   @db.Text
  generation_started_at  DateTime? @db.Timestamp(0)
  generation_finished_at DateTime? @db.Timestamp(0)
  provider_job_id        String?   @db.VarChar(500)
  provider_job_url       String?   @db.Text

  @@map("content_image")
}

model image_file {
  id        String @id @db.VarChar(100)
  file_path String @db.Text
}

model search_history {
  id           String   @id @db.VarChar(36)
  term         String   @db.VarChar(1000)
  created_at   DateTime @default(now()) @db.Timestamp(0)
  result_count Int

  @@index([result_count, created_at], map: "idx_search_result_count_created_at")
}

model history_generation_fail {
  id         String   @id @db.VarChar(100)
  slug       String   @db.VarChar(500)
  created_at DateTime @db.Timestamp(0)
  reason     String?  @db.VarChar(1000)
  exception  String?  @db.Text
  content    String?  @db.Text
}

model generation_schedule {
  id       String   @id @db.VarChar(100)
  next_run DateTime @db.Timestamp(0)
}

model not_found_request {
  id             String    @id @db.VarChar(36)
  url            String    @unique @db.VarChar(2000)
  hit_count      Int       @default(1)
  first_seen_at  DateTime  @default(now()) @db.Timestamp(0)
  last_seen_at   DateTime  @default(now()) @db.Timestamp(0)
  generated_slug String?   @db.VarChar(500)
  generated_at   DateTime? @db.Timestamp(0)

  @@index([generated_at, hit_count, last_seen_at], map: "idx_not_found_request_admin")
}
