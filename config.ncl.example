let Writer = {
  id | String,
  nickname | String,
  slug | String,
  provider | String, # "openrouter" or "openai"
  available | Bool,
  admin_only | Bool,
}
in
{
  secrets = {
    database_url = "",
    nextauth_secret = "",
    translation_worker_secret = "",
    sso_client_secret = "",
    admin_email = "",
    safety_identifier_secret = "",
    # Optional: only writers with provider = "openai" (and moderation) need it.
    openai_api_key = "",
    openrouter_api_key = "",
    replicate_api_token = "",
    loggly_token = "",
  },

  app = {
    site_url = "https://wibble.fbmac.net",
    sso_public_url = "https://sso.fbmac.net",
    discord_url = "https://discord.gg/Ev2J94xDNY",
    images_dir = "/data/images",
  },

  auth = {
    sso_issuer_url = "https://sso.fbmac.net/api/auth",
    sso_client_id = "639bbd38-bece-4ce9-a8fb-43520804f733",
  },

  generation = {
    writers | Array Writer = [
      {
        id = "deepseek-flash",
        nickname = "DeepSeek Flash",
        slug = "deepseek/deepseek-v4-flash-0731",
        provider = "openrouter",
        available = true,
        admin_only = false,
      },
    ],
    openrouter_api_url = "https://openrouter.ai/api/v1/chat/completions",
    # Optional OpenAI support: writers with provider = "openai" also require
    # generation.openai_api_url, and moderation additionally requires
    # generation.moderation_api_url (both backed by secrets.openai_api_key).
    moderation_enabled = false,
    max_output_tokens = 16000,
    max_prompt_length = 2000,
  },

  image = {
    mode = "replicate",
    replicate_api_url = "https://api.replicate.com/v1/models/black-forest-labs/flux-schnell/predictions",
    minimum_request_interval_seconds = 30,
  },

  worker = {
    cool_down_seconds = 10,
    idle_sleep_seconds = 10,
    wait_on_error_seconds = 60,
    update_scores_interval_seconds = 900,
  },

  logging = {
    loggly_subdomain = "fbmac",
    web_tags = ["wibble-web"],
    worker_tags = ["wibble-worker"],
  },
}
